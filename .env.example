# MyDGX escucha solo en el equipo local por defecto.
HOST=127.0.0.1
PORT=8088
# Nombres o IPs extra con los que se abre el dashboard y el gateway (separados por comas).
# Loopback y las IPs propias del equipo ya están permitidas; el resto se rechaza (DNS rebinding).
TRUSTED_HOSTS=

# Apps que un perfil puede arrancar al cargarse y detener al pararse.
# Cada app es un subdirectorio de PROFILE_APPS_ROOT (vacío = home del usuario del servicio)
# con su propio start.sh (start/stop/restart/status). PROFILE_APPS limita la lista (p. ej. ragkit).
PROFILE_APPS_ROOT=
PROFILE_APPS=
APP_NAME=MyDGX

# Persistencia y telemetría
DATABASE_PATH=./data/mydgx.db
METRICS_INTERVAL_SECONDS=5
METRICS_RETENTION_HOURS=168
LOG_RETENTION_DAYS=30

# Servicios locales
OLLAMA_URL=http://127.0.0.1:11434
OPENWEBUI_URL=http://127.0.0.1:3000
# URL que recibe el navegador; usa el puerto local del túnel para equipos remotos.
OPENWEBUI_PUBLIC_URL=
# El deployment genera una credencial independiente para las herramientas locales.
OPENWEBUI_TOOL_API_KEY=
DGX_DASHBOARD_URL=http://127.0.0.1:11000
HF_HOME=~/.cache/huggingface
# Descargas simultáneas de archivos/shards; Xet usa además transferencias segmentadas.
HF_DOWNLOAD_WORKERS=4

# Recomendación dinámica para uno o varios DGX Spark enlazados.
# Solo aumenta SPARK_CLUSTER_SIZE si el runtime y ConnectX-7 están configurados.
SPARK_CLUSTER_SIZE=1
SPARK_MEMORY_BANDWIDTH_GBPS=273

# Perfiles de inferencia
LLAMA_CPP_SERVER_PATH=llama-server
# Descomenta para activar y cargar este perfil al desplegar y al arrancar.
# DEFAULT_PROFILE_ID=artifex-tiel-q6
# Binarios CUDA 13 / sm_121 opcionales para los perfiles ARTIFEX.
# Si quedan vacíos, se usa LLAMA_CPP_SERVER_PATH.
LLAMA_CPP_B10679_PATH=
LLAMA_CPP_B11429_PATH=
ENABLE_PROFILE_AUTOSTART=true
PROFILE_BIND_HOST=127.0.0.1
PROFILE_START_TIMEOUT_SECONDS=180

# Gateway OpenAI compatible del perfil activo
GATEWAY_ENABLED=true
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=4000
GATEWAY_REQUEST_TIMEOUT_SECONDS=600
GATEWAY_MAX_REQUEST_MB=32
# Puerto interno, solo localhost, usado por el adaptador LiteLLM.
GATEWAY_LITELLM_PORT=4001
# Orígenes web explícitos separados por comas. Vacío bloquea llamadas directas desde navegador.
GATEWAY_CORS_ORIGINS=
# Obligatoria para escuchar fuera de localhost.
GATEWAY_API_KEY=
# OpenCode y Claude Code no copian esta clave a su configuración. Para un
# gateway remoto, expórtala como MYDGX_GATEWAY_API_KEY en la shell que ejecuta
# start.sh.
# MYDGX_OPENCODE_MAX_STEPS=8192
# MYDGX_OPENCODE_MAX_OUTPUT_TOKENS=8192
# MYDGX_CLAUDE_MAX_OUTPUT_TOKENS=8192

# Endpoints opcionales usados únicamente para descubrir motores existentes.
VLLM_URL=http://127.0.0.1:8000
SGLANG_URL=http://127.0.0.1:30000
TRTLLM_URL=http://127.0.0.1:8001
LMSTUDIO_URL=http://127.0.0.1:1234
COMFYUI_URL=http://127.0.0.1:8188
# URL que recibe el navegador; usa el puerto local del túnel para equipos remotos.
COMFYUI_PUBLIC_URL=
WHISPER_URL=http://127.0.0.1:9000
RIVA_URL=http://127.0.0.1:8002

# Límites para el laboratorio multimodal. Las entradas se mantienen en memoria;
# los vídeos generados se guardan como artefactos locales privados, no en SQLite.
MULTIMODAL_MAX_UPLOAD_MB=64

# Asistente local de MyDGX. Si el modelo preferido no está disponible, usa
# automáticamente otro modelo de chat instalado o perteneciente al perfil activo.
ASSISTANT_ENABLED=true
ASSISTANT_MODEL=llama3.2:3b
ASSISTANT_FALLBACK_TO_AVAILABLE=true
ASSISTANT_MIN_FALLBACK_PARAMETERS_B=3
ASSISTANT_MAX_TOOL_ROUNDS=6
ASSISTANT_ACTION_TTL_SECONDS=300

# Benchmarks reproducibles. Al cargar un perfil o descargar un modelo Ollama se
# encola un benchmark; el planificador espera a que no haya jobs, inferencia ni
# uso interactivo reciente (BENCHMARK_QUIET_SECONDS) antes de ejecutarlo.
BENCHMARK_ENABLED=true
BENCHMARK_AUTO_NEW_MODELS=true
BENCHMARK_REPETITIONS=3
BENCHMARK_TELEMETRY_INTERVAL_SECONDS=1
BENCHMARK_QUIET_SECONDS=120
BENCHMARK_QUEUE_POLL_SECONDS=20
BENCHMARK_QUEUE_MAX_AGE_HOURS=24
# Descarga de memoria los modelos Ollama inactivos que no pertenecen a un perfil
# cargado (p. ej. el modelo del asistente) antes de medir.
BENCHMARK_RELEASE_IDLE_OLLAMA=true

# Opcional si el fabricante no aparece correctamente en DMI/device-tree:
# nvidia, asus, hp, lenovo o generic
DEVICE_VARIANT_OVERRIDE=

# Secretos: añade los valores únicamente en tu archivo .env local.
HF_TOKEN=
MYDGX_API_KEY=
# Si se define, el dashboard muestra el login y conserva una cookie HttpOnly
# durante un máximo absoluto de 60 minutos. No guardes la contraseña en git.
MYDGX_DASHBOARD_PASSWORD=
MYDGX_SESSION_TTL_MINUTES=60
# DuckDNS opcional. Configura estos valores solo en el .env del DGX y despliega
# con: ./start.sh deploy --duckdns --repair --interactive
DUCKDNS_DOMAIN=
DUCKDNS_TOKEN=

# Operaciones privilegiadas, desactivadas por defecto.
ENABLE_SYSTEM_UPDATES=false
ENABLE_SERVICE_CONTROL=false
MANAGED_SERVICES=mydgx,mydgx-gateway,mydgx-searxng,mydgx-comfyui,mydgx-whisper,ollama,docker,open-webui
