# Copia este archivo como dgx-spark.env y aplica chmod 600.
# ./start.sh test crea la copia local automáticamente cuando no existe.

# Nombre mDNS o dirección IP mostrada por el DGX Spark.
DGX_HOST=spark-xxxx.local

# Cuenta creada durante el primer arranque de DGX OS.
DGX_USER=nvidia
DGX_PORT=22

# Capacidad del SSD adquirido: 1 o 4 TB.
DGX_EXPECT_DISK_TB=1

# Clave privada OpenSSH opcional. Nunca se copia ni se imprime.
# DGX_IDENTITY=~/.ssh/id_ed25519

# Tiempo máximo para resolución, TCP y handshake SSH.
DGX_TIMEOUT=5

# Con 1 acepta y guarda claves nuevas. Si el mismo host:puerto presenta una
# clave distinta (habitual al reutilizar una IP alquilada), avisa, sustituye
# únicamente esa entrada y continúa.
DGX_ACCEPT_NEW=0

# Fijación estricta opcional. Si se define, una huella distinta siempre bloquea.
# DGX_EXPECT_FINGERPRINT=SHA256:HUELLA_VERIFICADA

# Con 1, los avisos y comprobaciones omitidas devuelven código 3.
DGX_STRICT=0

# Con 1, OpenSSH puede pedir la contraseña directamente en esta terminal.
# El script nunca recibe ni almacena esa contraseña.
DGX_INTERACTIVE=0

# Alias opcional para known_hosts.
# DGX_HOST_KEY_ALIAS=mi-dgx-spark
